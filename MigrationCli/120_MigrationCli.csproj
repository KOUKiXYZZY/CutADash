<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CutADash.MigrationCli</RootNamespace>
    <AssemblyName>MigrationCli</AssemblyName>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;DevDebug</Configurations>
    <Platforms>x86;x64;ARM64</Platforms>
    <!-- 開発時に手で叩くための道具であり、配布物には含めない。
         CutADash側からは参照しないので、ここでだけ自己完結型にして単体で実行できるようにする -->
    <RuntimeIdentifier Condition="'$(Platform)'=='x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)'=='x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)'=='ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Migration\060_Migration.csproj" />
  </ItemGroup>

</Project>
