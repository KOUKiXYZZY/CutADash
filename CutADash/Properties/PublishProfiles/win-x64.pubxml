<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\win-x64\publish\win-x64\win-x64\win-x64\</PublishDir>
    <!-- フレームワーク依存は配布ファイル数を減らせるが、実行環境に.NET 8 Desktop
         Runtimeのインストールが必須になる。開発機にすら入っていなかったことが
         判明し、配布先でも同様に動かない可能性が高いため自己完結型に戻した -->
    <SelfContained>true</SelfContained>
    <Configuration>Release</Configuration>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- PublishSingleFileはWinUI3(アンパッケージ)のXAML/リソース読み込みと相性が悪く
         XamlParseExceptionで起動時にクラッシュするため使わない -->
    <!-- WinUI3(アンパッケージ)のXAML/リソース読み込みはAssembly.Locationベースの実パスを
         前提にしており、単一ファイルバンドルだとMainWindow.InitializeComponent()が
         XamlParseExceptionになって起動不能になる。IncludeAllContentForSelfExtractや
         pri/xbfの単一ファイル除外(ExcludeFromSingleFile)を試したが解消せず、既知の
         回避策が見つからなかったため無効にしている -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>