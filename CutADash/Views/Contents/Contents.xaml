<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="EditorHost"
    
    x:Class="CutADash.Views.Contents.Contents"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CutADash"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="using:CutADash.Views.Converter"
    xmlns:viewModels="using:CutADash.ViewModels"
    xmlns:wv2="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="EditorBorder"
                Grid.Row="0"
                CornerRadius="2"
                BorderThickness="0">
            <Grid>
                <!-- ImageAreaGrid内のBorderと同じ背景・Margin・CornerRadiusにして、
                     テキスト/画像/ファイルのどの表示でも同じ見た目の面の上に載るようにする -->
                <Border Margin="12"
                        CornerRadius="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <!-- 猫テーマの間だけ、編集面の背後に肉球を薄っすらと散らして表示する
                             (ApplyCatContentsBackgroundで切り替え)。RichEditBoxのBackgroundが
                             Transparentなので、下に敷いたこのGridがそのまま透けて見える -->
                        <Grid x:Name="CatPawBackground"
                              Visibility="Collapsed"
                              IsHitTestVisible="False">
                            <TextBlock Text="&#x1F43E;" FontSize="120" Opacity="0.05"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="24,16,0,0"/>
                            <TextBlock Text="&#x1F43E;" FontSize="90" Opacity="0.05"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Margin="0,0,32,40"/>
                            <TextBlock Text="&#x1F43E;" FontSize="70" Opacity="0.05"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <RichEditBox x:Name="CodeEditor"
                                Padding="12"
                                BorderThickness="0"
                                CornerRadius="0"
                                IsReadOnly="True"
                                FontFamily="Cascadia Code, Consolas, Courier New"
                                FontSize="13"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False"
                                AcceptsReturn="True"
                                TextWrapping="NoWrap"
                                SelectionFlyout="{x:Null}"
                                ContextFlyout="{x:Null}"
                                Background="Transparent"
                                Typography.StandardLigatures="False"
                                Typography.ContextualAlternates="False"
                                Typography.DiscretionaryLigatures="False"
                                Typography.HistoricalLigatures="False">
                        <RichEditBox.Resources>
                            <ResourceDictionary>
                                <!-- 文字色はテーマに追従させる。ライトは黒っぽく、ダークは白。
                                     通常時だけでなくPointerOver/Focusedも指定しないと、
                                     マウスを乗せた時やフォーカス時に既定色へ戻ってしまう。
                                     IsReadOnly=Trueにすると既定テンプレートは"Disabled"の
                                     ビジュアルステートを使い、TextControlForegroundDisabled
                                     (既定は薄いグレー)で文字を描くため、ここも上書きしないと
                                     文字がほぼ見えなくなる -->
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="TextControlForeground" Color="#1C1C1C"/>
                                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1C1C1C"/>
                                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1C1C1C"/>
                                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#1C1C1C"/>
                                    </ResourceDictionary>
                                    <!-- Defaultはダークテーマ時に使われる -->
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FFFFFF"/>
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>

                                <SolidColorBrush
                                            x:Key="TextControlSelectionHighlightColor"
                                            Color="#5B6078"/>
                                <SolidColorBrush
                                            x:Key="TextControlBorderBrushFocused"
                                            Color="Transparent"/>
                                <SolidColorBrush
                                            x:Key="TextControlBorderBrush"
                                            Color="Transparent"/>
                                <SolidColorBrush
                                            x:Key="TextControlBorderBrushPointerOver"
                                            Color="Transparent"/>
                                <SolidColorBrush
                                            x:Key="TextControlBackgroundPointerOver"
                                            Color="Transparent"/>
                                <SolidColorBrush
                                            x:Key="TextControlBackgroundFocused"
                                            Color="Transparent"/>
                                <SolidColorBrush
                                            x:Key="TextControlBackgroundDisabled"
                                            Color="Transparent"/>
                                <SolidColorBrush
                                            x:Key="TextControlBorderBrushDisabled"
                                            Color="Transparent"/>
                            </ResourceDictionary>
                        </RichEditBox.Resources>
                    </RichEditBox>
                    </Grid>
                </Border>

                <Grid x:Name="ImageAreaGrid" Visibility="Collapsed">
                    <!-- ウィンドウ自体がAcrylic/Blur/Micaの半透明背景のため、透過PNG等を
                         そのまま乗せるとアルファが分かりづらい。画像の背後にテーマ追従の
                         不透明な面を敷いて、透明度がはっきり見えるようにする -->
                    <Border Margin="12"
                            CornerRadius="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Image x:Name="ImagePreview"
                                Stretch="Uniform"
                                Margin="12" />
                    </Border>
                </Grid>

                <ListView x:Name="FilesPreview"
                          Visibility="Collapsed"
                          Margin="12"
                          IsItemClickEnabled="False"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                                <FontIcon Glyph="&#xE7C3;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind}"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        <!-- 履歴が1件も無いときに表示する -->
        <TextBlock x:Name="EmptyText"
                   Grid.Row="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="Gray"
                   FontSize="16"
                   IsHitTestVisible="False"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- 下部のボタン列がエディタへ落とす影。行0の最下部に重ねて描くため、
             エディタより後ろに置いて手前に来るようにし、操作を邪魔しないよう
             ヒットテストからは外す(ListFrameと同じ作り) -->
        <Border Grid.Row="0"
                Height="8"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                Background="{StaticResource BottomBarShadowBrush}"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Height="32">
            <!-- リッチテキスト項目のときだけ表示する、書式付き/プレーンテキストの
                 貼り付け先選択ドロップダウン -->
            <DropDownButton x:Name="PasteButton"
                             Height="32"
                             Padding="10,0"
                             Margin="1,0,0,1"
                             Background="Transparent"
                             BorderThickness="0"
                             CornerRadius="0"
                             Visibility="{Binding ShowPasteButton, Converter={StaticResource BoolToVisibilityConverter}}"
                             FocusVisualPrimaryThickness="{StaticResource AppFocusVisualPrimaryThickness}"
                             FocusVisualSecondaryThickness="{StaticResource AppFocusVisualSecondaryThickness}">
                <TextBlock x:Name="PasteButtonText" FontSize="12"/>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Top">
                        <MenuFlyoutItem x:Name="PasteFormattedMenuItem"
                                        Command="{Binding PasteFormattedCommand}"
                                        Visibility="{Binding ShowPasteFormatted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <MenuFlyoutItem x:Name="PastePlainMenuItem" Command="{Binding PastePlainCommand}"/>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <!-- Base64/URL/QRの各形式を、Encode/Decodeそれぞれ1つのドロップダウンに
                 まとめる。Textのときはその場で変換して直前のフォアグラウンドウィンドウへ
                 ペーストし、QRのDecodeだけは画像から読み取って下のテキストボックスに表示する -->
            <DropDownButton x:Name="EncodeButton"
                             Height="32"
                             Padding="10,0"
                             Margin="1,0,0,1"
                             Background="Transparent"
                             BorderThickness="0"
                             CornerRadius="0"
                             IsEnabled="{Binding CanEncode}"
                             FocusVisualPrimaryThickness="{StaticResource AppFocusVisualPrimaryThickness}"
                             FocusVisualSecondaryThickness="{StaticResource AppFocusVisualSecondaryThickness}"
                             ToolTipService.ToolTip="Encode">
                <TextBlock Text="Encode" FontSize="12"/>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Top">
                        <MenuFlyoutItem x:Name="Base64EncodeMenuItem" Text="Base64" Click="Base64EncodeButton_Click"/>
                        <MenuFlyoutItem x:Name="UrlEncodeMenuItem" Text="URL" Click="UrlEncodeButton_Click"/>
                        <MenuFlyoutItem x:Name="QrEncodeMenuItem" Text="QR" Click="QrEncodeButton_Click"/>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <DropDownButton x:Name="DecodeButton"
                             Height="32"
                             Padding="10,0"
                             Margin="1,0,0,1"
                             Background="Transparent"
                             BorderThickness="0"
                             CornerRadius="0"
                             IsEnabled="{Binding CanDecode}"
                             FocusVisualPrimaryThickness="{StaticResource AppFocusVisualPrimaryThickness}"
                             FocusVisualSecondaryThickness="{StaticResource AppFocusVisualSecondaryThickness}"
                             ToolTipService.ToolTip="Decode">
                <TextBlock Text="Decode" FontSize="12"/>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Top" Opening="DecodeFlyout_Opening">
                        <MenuFlyoutItem x:Name="Base64DecodeMenuItem" Text="Base64" Click="Base64DecodeButton_Click"
                                        IsEnabled="{Binding CanDecodeBase64}"
                                        Visibility="{Binding IsDecodeTargetText, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <MenuFlyoutItem x:Name="UrlDecodeMenuItem" Text="URL" Click="UrlDecodeButton_Click"
                                        IsEnabled="{Binding CanDecodeUrl}"
                                        Visibility="{Binding IsDecodeTargetText, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <MenuFlyoutItem x:Name="QrDecodeMenuItem" Text="QR" Command="{Binding QrDecodeCommand}"
                                        Visibility="{Binding IsDecodeTargetImage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>
    </Grid>
</Page>
