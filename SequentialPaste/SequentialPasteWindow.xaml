<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    xmlns:winex="using:WinUIEx"
    x:Class="SequentialPaste.SequentialPasteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SequentialPaste"
    xmlns:models="using:CutADash.Models"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="260"
    Title="シーケンシャルペースト">

    <!-- MainWindowと見た目を揃える: タイトルバーを消し、ドラッグハンドル+専用の
         閉じるボタン+下端の区切り線を自前で用意する構成(MainWindow.xamlのTitleBarRow参照) -->
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <local:SequentialPasteItemPreviewConverter x:Key="PreviewConverter"/>
            <local:CountTextConverter x:Key="CountTextConverter"/>
            <local:WatchingToButtonTextConverter x:Key="WatchingToButtonTextConverter"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarRow" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 閉じるボタンの左側を掴んでウィンドウを移動できるドラッグ領域 -->
            <Grid x:Name="DragHandle"
                  Grid.Column="0"
                  Height="32"
                  Background="Transparent">
                <TextBlock Text="シーケンシャルペースト"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- ウィンドウ閉じるボタン(MainWindowと同じスタイル) -->
            <Button Grid.Column="1"
                Width="42" Height="32"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="0"
                IsTabStop="False"
                Click="CloseButton_Click">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E81123"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#F1707A"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                </Button.Resources>
                <FontIcon Glyph="&#xE8BB;" FontSize="10"/>
            </Button>

            <!-- タイトルバーと本体の境界線 -->
            <Border Grid.Column="0" Grid.ColumnSpan="2"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource DividerBrushHorizontal}"/>
        </Grid>

        <Grid Grid.Row="1" Padding="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="CountText"
                       Text="{Binding Count, Converter={StaticResource CountTextConverter}}"
                       Grid.Row="0"
                       Margin="4,0,0,4"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- SelectionMode=Single+SelectedIndexをNextIndex(次にペーストされる項目の
                 インデックス)へTwoWayバインドすることで、行を見て次に何が貼り付けられるか
                 分かるようにする。クリックして選び直すこともできる。SelectedItem(参照)ではなく
                 SelectedIndexを使うのは、同じ内容/同じ参照の項目が複数あっても常に正しい行を
                 指せるようにするため(参照で探すと同じ内容の別の行を指してしまうことがあった)。
                 選択行の背景色はシステムのアクセントカラーに合わせる -->
            <ListView x:Name="QueueListView"
                      Grid.Row="1"
                      SelectionMode="Single"
                      SelectedIndex="{Binding NextIndex, Mode=TwoWay}"
                      ItemsSource="{Binding Items}"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColorLight1}"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColorDark1}"/>
                    <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="TextOnAccentFillColorPrimaryBrush"/>

                    <!-- 選択行の左端に出るアクセント色のインジケータバーは不要なため消す -->
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                </ListView.Resources>
                <!-- フォーカス枠を細くする(ListFrameと同じ理由。App.xamlのimplicitスタイルだと
                     起動時クラッシュするため、ここでページ/ウィンドウスコープで指定する) -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource AppFocusVisualPrimaryThickness}"/>
                        <Setter Property="FocusVisualSecondaryThickness" Value="{StaticResource AppFocusVisualSecondaryThickness}"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <!-- ListFrame(履歴一覧)のTextTemplateと同じ見た目(余白・行区切り線・
                         トリミング)にしている -->
                    <DataTemplate x:DataType="models:ClipboardItem">
                        <Grid Padding="8" Background="Transparent" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 既に貼り付け済みの項目の頭にチェックマークを付ける -->
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE73E;" FontSize="14"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding IsPasted, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Converter={StaticResource PreviewConverter}}"
                                       FontSize="16"
                                       MaxLines="1"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="2"
                                    Width="32" Height="32"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    FocusVisualPrimaryThickness="{StaticResource AppFocusVisualPrimaryThickness}"
                                    FocusVisualSecondaryThickness="{StaticResource AppFocusVisualSecondaryThickness}"
                                    Command="{Binding ElementName=QueueListView, Path=DataContext.RemoveCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTipService.ToolTip="削除">
                                <FontIcon Glyph="&#xE711;" FontSize="12"/>
                            </Button>

                            <Border Grid.ColumnSpan="3"
                                    Height="1"
                                    Margin="-8,0,-8,-8"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource DividerBrushHorizontal}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText"
                       Grid.Row="1"
                       Text="キューは空です"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <!-- 押すと物理Ctrl+Vの監視を開始/停止する(SequentialPasteHotkeyWatcher)。
                     押している間はどのアプリでCtrl+Vしてもキューの先頭が1件ずつ貼り付けられる -->
                <Button x:Name="StartStopButton"
                        Content="{Binding IsWatching, Converter={StaticResource WatchingToButtonTextConverter}}"
                        Padding="10,0"
                        Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        FocusVisualPrimaryThickness="{StaticResource AppFocusVisualPrimaryThickness}"
                        FocusVisualSecondaryThickness="{StaticResource AppFocusVisualSecondaryThickness}"
                        Command="{Binding ToggleWatchingCommand}"/>
                <Button x:Name="ClearButton"
                        Content="全消去"
                        Padding="10,0"
                        Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        FocusVisualPrimaryThickness="{StaticResource AppFocusVisualPrimaryThickness}"
                        FocusVisualSecondaryThickness="{StaticResource AppFocusVisualSecondaryThickness}"
                        Command="{Binding ClearCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</winex:WindowEx>
