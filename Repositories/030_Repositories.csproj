<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
	  <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	  <RootNamespace>CutADash</RootNamespace>
	  <UseWinUI>false</UseWinUI>
	  <AssemblyName>Repositories</AssemblyName>
	  <Nullable>enable</Nullable>
	  <Configurations>Debug;Release;DevDebug</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- DB暗号化(SQLCipher)対応版。DbProviderInitializerが起動時に明示的にSQLCipher版の
         プロバイダを選択するため、sqlite-net-pclが暗黙に依存するbundle_greenと混在していても
         実害は無い -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <!-- sqlite-net-pclが暗黙に依存するSQLitePCLRaw.lib.e_sqlite3の既知の脆弱性
         (GHSA-2m69-gcr7-jv3q)対策。詳細はCommon/010_Common.csprojのコメント参照 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <!-- ClipboardItem.Text/RtfをObservablePropertyにするため(WinUI非依存の純粋なMVVM Toolkit機能) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\010_Common.csproj" />
  </ItemGroup>

</Project>
