<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
	  <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	  <RootNamespace>Common</RootNamespace>
	  <UseWinUI>true</UseWinUI>
	  <AssemblyName>Common</AssemblyName>
	  <Nullable>enable</Nullable>
	  <Configurations>Debug;Release;DevDebug</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1721" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260416003" />
    <PackageReference Include="WinUIEx" Version="2.9.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- DB暗号化(SQLCipher)対応版。sqlite-net-pclが暗黙に依存するbundle_green(素のSQLite)の
         ネイティブライブラリも出力フォルダに混在するが、DbProviderInitializerで起動時に
         明示的にSQLCipher版のプロバイダを選択するため、混在していても実害は無い -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.11" />
    <!-- sqlite-net-pclが暗黙に依存するSQLitePCLRaw.lib.e_sqlite3は2.1.2のまま(既知の
         脆弱性GHSA-2m69-gcr7-jv3q(CVE-2025-6965、SQLite<3.50.2起因)。
         2.1.11以下は全て対象のため、明示参照で2.1.13へ引き上げる -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinAPI\100_WinAPI.csproj" />
  </ItemGroup>

</Project>
