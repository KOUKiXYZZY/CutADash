<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UiLibrary.ChipInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UiLibrary"
    MinWidth="240">

    <UserControl.Resources>
        <!-- チップ1つ: 文字と、削除用の×ボタンを丸い枠に入れる -->
        <DataTemplate x:Key="ChipTemplate">
            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12,0,4,0"
                    Height="28">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="240"/>
                    <Button Tag="{Binding}"
                            Width="22" Height="22"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="11"
                            VerticalAlignment="Center"
                            Click="RemoveButton_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="10"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <TextBlock x:Name="HeaderTextBlock" Visibility="Collapsed"/>

        <!-- 追加済みのチップの一覧(幅に収まらなければ折り返す) -->
        <ItemsControl x:Name="ChipsControl"
                      ItemTemplate="{StaticResource ChipTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBox x:Name="InputBox"
                 AcceptsReturn="False"
                 KeyDown="InputBox_KeyDown"
                 TextChanged="InputBox_TextChanged"/>
    </StackPanel>
</UserControl>
